# ============================================
# VolunteerHub Development Configuration
# ============================================

NODE_ENV=development
PORT=3001

# Email - Using MailHog for local testing
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@volunteerhub.local
SMTP_SECURE=false

# Redis
REDIS_PASSWORD=dev_redis_password

# Rate Limiting (more permissive in dev)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# CORS
CORS_ORIGIN=http://localhost:3000
